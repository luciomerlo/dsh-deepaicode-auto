# Credential sources for dsh-deepaicode-auto.
#
# Copy this file to `.env` only if you keep credentials on disk. DeepSeek
# Harness reads `$DSH_HOME/.env` into the process environment, so the plugin can
# pick these up without any plugin configuration. `.env` is git-ignored.
#
# The plugin also works with no environment at all: it reuses the sign-in the
# DeepAI Code desktop app already stored, otherwise it starts the browser
# sign-in flow and stores the result under `$DSH_HOME/deepaicode/account.json`.

# Preferred name. A DeepAI account API key (UUID format).
DEEPAI_CODE_API_KEY=

# Accepted fallback name for the same key.
DEEPAI_API_KEY=

# Optional. Overrides the detected hardware identity used for the upstream
# machine fingerprint. The raw value is hashed locally and never transmitted,
# so this is only needed on hosts whose hardware id cannot be read.
DEEPAI_MACHINE_ID=
